# Copiez ce fichier en ".env" et adaptez selon la cible utilisée (voir le
# commentaire détaillé dans src/config.ts — la bonne valeur dépend du type
# d'appareil de test, PAS d'un choix arbitraire) :
#
#   - Émulateur Android      : http://10.0.2.2:4000/api/v1
#   - Simulateur iOS         : http://localhost:4000/api/v1
#   - Téléphone physique     : http://<IP locale de votre machine>:4000/api/v1
#     (ex. http://192.168.1.42:4000/api/v1 — le téléphone et la machine de
#     développement doivent être sur le même réseau Wi-Fi)
#
# Préfixe EXPO_PUBLIC_ obligatoire : c'est ce qui indique à Expo d'embarquer
# cette variable dans le bundle client (voir src/config.ts).
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000/api/v1"
